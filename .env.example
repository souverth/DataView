# =============================================================================
# OrcaQ — Environment Variables
# Copy this file to .env and customize as needed
# =============================================================================

# --- OrcaQ Application ---
ORCAQ_PORT=9432

# --- Docker (see docker/README.md) ---
# ORCAQ_IMAGE=orcaq:local
# ORCAQ_DEV_PORT=3000
# ORCAQ_DEV_HMR_PORT=24678

# Demo databases (docker compose --profile <name>)
# ORCAQ_DEMO_DB_USER=orcaq
# ORCAQ_DEMO_DB_PASSWORD=orcaq
# ORCAQ_DEMO_DB_ROOT_PASSWORD=root
# ORCAQ_DEMO_POSTGRES_PORT=15432
# ORCAQ_DEMO_MYSQL_PORT=13306
# ORCAQ_DEMO_MARIADB_PORT=13307
# ORCAQ_DEMO_REDIS_PORT=16379
# ORCAQ_DEMO_MONGODB_PORT=27018

# SQLite file connections read files inside the container (default: enabled).
# Docker Compose mounts ./data/sqlite -> /data/sqlite, e.g. /data/sqlite/app.sqlite.
# Set false on shared deployments that should not expose server-side file access.
# NUXT_PUBLIC_SQLITE3_CONNECTIONS_ENABLED=false
# Host folder for SQLite files (relative to docker/, or an absolute path)
# ORCAQ_SQLITE_DIR=../data/sqlite


# --- Analytics (optional) ---
# NUXT_AMPLITUDE_API_KEY=
